# Copy to fastlane/.env and fill in. The keys themselves stay outside the repository.

# App Store Connect API key (Users and Access > Integrations > App Store Connect API)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/Users/you/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Google Play service account JSON key
PLAY_JSON_KEY_PATH=/Users/you/.config/google-play/life-calendar.json

# Folder with generated store screenshots
SCREENSHOTS_SOURCE=archives/store_screenshots_3.1.0
